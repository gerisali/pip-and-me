# Copy to .env for local use (npm run dev). On Vercel, add these in Project → Settings → Environment Variables.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any code you like; the iPad asks for it once. Leave empty only for local testing.
APP_PASSCODE=

# Optional overrides
# CHAT_MODEL=claude-haiku-5-5
# CHAT_EFFORT=low
# STT_MODEL=gpt-transcribe
# TTS_PROVIDER=openai        # or: browser (device voice, free)
# TTS_MODEL=gpt-4o-mini-tts  # shuts down 2027-01-06 — change before then
# TTS_VOICE=marin
# MODERATION=on
